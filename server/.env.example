# ---------------------------------------------------------------------------
# Dundu Planning -- backend environment variables
#
# Local dev:  copy this file to ".env" in this folder and fill in real values.
# Hosting:    set these exact keys in your host's dashboard instead of a
#             committed file (Render/Railway: "Environment", a VPS: a real
#             .env next to the app). Never commit the real ".env" -- it's
#             already in .gitignore.
#
# Every one of these is read in exactly one place: server/src/config/env.js.
# ---------------------------------------------------------------------------

# --- Database ----------------------------------------------------------------
# MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers).
# DEV:  can also point at a local Mongo, e.g. mongodb://127.0.0.1:27017/dundu-planning
# HOST: whatever host you deploy to needs its outbound IP allowed in Atlas ->
#       Network Access. Most hosts don't have a static IP, so 0.0.0.0/0
#       ("allow from anywhere") is the practical choice there -- Atlas still
#       enforces the username/password on top of it.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dundu-planning?retryWrites=true&w=majority

# --- Server --------------------------------------------------------------
# Port the API listens on.
# DEV:  5050 (matches client/vite.config.js's dev proxy target)
# HOST: most platforms (Render, Railway, Heroku-style) inject their own PORT
#       at runtime and ignore this value -- that's handled automatically in
#       config/env.js, so you don't need to change anything here for them.
PORT=5050

# "development" locally; set to "production" on your host. Controls cookie
# security flags (see src/utils/generateToken.js) and disables the noisy
# request logger.
NODE_ENV=development

# --- Auth --------------------------------------------------------------------
# Login uses two tokens: a short-lived access token (sent on every request)
# and a long-lived refresh token (sent only to /api/auth/*) that silently
# renews it -- so a session survives far longer than the access token's own
# lifetime without the browser ever needing to notice. See
# src/utils/generateToken.js for how they're issued.
#
# JWT_SECRET signs the access token. Generate a long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value in production than in dev, and never reuse one across apps.
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m

# JWT_REFRESH_SECRET signs the refresh token -- defaults to JWT_SECRET above
# if left unset, so this works out of the box, but generate a second,
# DIFFERENT random string (same command as above) for real use.
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS --------------------------------------------------------------------
# The URL(s) the frontend is served from -- comma-separate more than one
# (handy for a staging + production frontend at once).
# DEV:  http://localhost:5173
# HOST: your deployed frontend's real URL, e.g. https://dundu-planning.vercel.app
CLIENT_URL=http://localhost:5173

# --- One-time super admin seed (`npm run seed`) -----------------------------
# Only used the first time you seed an empty database -- ignored afterwards.
# Change the password immediately after first login in production.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@dundu.local
SUPERADMIN_PASSWORD=ChangeMe123!
