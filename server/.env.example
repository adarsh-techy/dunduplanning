# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/dundu-planning

# Server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - the URL the React app is served from
CLIENT_URL=http://localhost:5173

# One-time super admin seed (run `npm run seed`)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@dundu.local
SUPERADMIN_PASSWORD=ChangeMe123!
