# ---------------------------------------------------------------------------
# Dundu Planning -- frontend environment variables
#
# Local dev:  copy this file to ".env" in this folder. Leave VITE_API_URL
#             blank/unset -- the dev server proxies "/api" to your local
#             backend already (see vite.config.js).
# Hosting:    set VITE_API_URL in your host's dashboard (Vercel/Netlify:
#             "Environment Variables") to your deployed backend's URL, then
#             rebuild -- Vite only reads these at build time, not at runtime.
#
# Vite only exposes variables prefixed VITE_ to the browser bundle -- never
# put a secret behind that prefix, it will end up visible in the shipped JS.
# ---------------------------------------------------------------------------

# Full URL of the deployed backend API, including the "/api" prefix.
# DEV:  leave commented out.
# HOST: e.g. VITE_API_URL=https://dundu-planning-api.onrender.com/api
# VITE_API_URL=

# Only used by vite.config.js's dev proxy, to match whatever PORT the local
# backend is running on (server/.env). Not needed once you're building for
# a host -- VITE_API_URL above replaces it there.
VITE_DEV_API_PORT=5050
